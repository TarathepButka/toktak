# ==========================================
# Backend & Social Login Environment Variables
# ==========================================
PORT=8080

# Database Configuration (PostgreSQL via Docker Compose)
TOKTAK_DB_PATH=postgres://toktak:toktak@localhost:5432/toktak?sslmode=disable

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=toktak-videos
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Social Login Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
LINE_CHANNEL_ID=your_line_channel_id_here
